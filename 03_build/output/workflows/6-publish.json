    {
      "parameters": {
        "jsCode": "// \"Failed\": every error in Publish ends here, so the orchestrator sends a short note instead of crashing.\nconst j = $input.first().json;\nconst reason = j.reason || `Publish failed: ${j.error?.message || j.message || \"unknown error\"}`;\nreturn [{ json: { ok: false, step: \"Publish\", reason } }];\n"
      },
