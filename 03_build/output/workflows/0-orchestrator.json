      "parameters": {
        "jsCode": "// Every source the newsroom watches. Any Vancouver open data dataset with a date,\n// a category and a neighbourhood field works: add one object here.\n// filter is optional ODSQL, added to every query with \"and\".\nreturn [\n  {\n    id: \"311\",\n    portal: \"https://opendata.vancouver.ca\",\n    dataset: \"3-1-1-service-requests\",\n    label: \"3-1-1 service requests\",\n    source_note: \"City of Vancouver open data, 3-1-1 service requests\",\n    source_url: \"https://opendata.vancouver.ca/explore/dataset/3-1-1-service-requests/\",\n    unit: \"reports\",\n    date_field: \"service_request_open_timestamp\",\n    category_field: \"service_request_type\",\n    area_field: \"local_area\",\n    date_only: false,\n    max_age_hours: 48,\n    filter: \"\",\n  },\n  {\n    id: \"permits\",\n    portal: \"https://opendata.vancouver.ca\",\n    dataset: \"issued-building-permits\",\n    label: \"issued building permits\",\n    source_note: \"City of Vancouver open data, issued building permits\",\n    source_url: \"https://opendata.vancouver.ca/explore/dataset/issued-building-permits/\",\n    unit: \"permits\",\n    date_field: \"issuedate\",\n    category_field: \"typeofwork\",\n    area_field: \"geolocalarea\",\n    date_only: true,\n    max_age_hours: 120,\n    filter: \"\",\n  },\n  {\n    id: \"licences\",\n    portal: \"https://opendata.vancouver.ca\",\n    dataset: \"business-licences\",\n    label: \"business licences\",\n    source_note: \"City of Vancouver open data, business licences\",\n    source_url: \"https://opendata.vancouver.ca/explore/dataset/business-licences/\",\n    unit: \"licences\",\n    date_field: \"issueddate\",\n    category_field: \"businesstype\",\n    area_field: \"localarea\",\n    date_only: false,\n    max_age_hours: 120,\n    filter: \"\",\n  },\n].map((json) => ({ json }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
