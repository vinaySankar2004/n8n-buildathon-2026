# Copy this file to .env in the repository root and fill in what applies to you.
# .env is git-ignored, and the commit check blocks any commit that contains one of its values.

# Reaching n8n. Everyone who deploys needs both.
# On the host laptop use http://localhost:5678; everyone else uses the tunnel.
N8N_URL=https://paratactical-professionally-yasuko.ngrok-free.dev
# Shared by Vinayak in a direct message. Never in a channel, doc or commit.
N8N_API_KEY=

# Service keys. Only the person who owns a key fills it in, once, then runs `npm run credentials`,
# which stores it inside n8n. Nobody else needs it after that, so leave the rest blank.
# A blank value is skipped, so it never overwrites a key someone else loaded.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
SLACK_BOT_TOKEN=
# Host laptop only: the same value as RENDER_TOKEN in 03_build/output/render-service/.env.
RENDER_TOKEN=

# Host laptop only, for `npm run host`, which starts n8n, rendering, the router and the tunnel.
# N8N_START is the full path to the script that starts the self-hosted n8n.
N8N_START=
TUNNEL_URL=https://paratactical-professionally-yasuko.ngrok-free.dev
